#!/usr/bin/env nu

# Install the dictionaries the AU-English vale spelling style reads,
# and generate the term lists that come from this repository.
#
# Writes into ci/vale/styles:
#
#   config/dictionaries/en_AU-large.{dic,aff}  hunspell en_AU base dictionary
#   config/dictionaries/tech.{dic,aff}         cspell-derived tech dictionary
#   config/dictionaries/terms.txt              allow-list of repository names
#   AU-English/Terms.yml                       host name casing rule
#
# Every file written here is gitignored.
#
# The dictionary paths come from HUNSPELL_EN_AU and VALE_TECH_DICTIONARY,
# and are built with nix when those are unset.

use std/log
use lib/flake.nu *

# Nix writes host names without capitals, so the documentation form is derived here:
# `nix<rest>` becomes `Nix<Rest>`, except where the suffix is an initialism.
const HOST_NAME_EXCEPTIONS = {
  nixai: "NixAI"
  nixio: "NixIO"
}

def repo_root [] {
  $env.GIT_ROOT
}

def styles_dir [] {
  (repo_root) | path join "ci/vale/styles"
}

def dictionary_dir [] {
  (styles_dir) | path join "config/dictionaries"
}

def canonical_host_name [host: string] {
  if ($host in $HOST_NAME_EXCEPTIONS) {
    $HOST_NAME_EXCEPTIONS | get $host
  } else if ($host | str starts-with "nix") {
    let suffix = ($host | str substring 3..)
    $"Nix($suffix | str title-case)"
  } else {
    $host | str title-case
  }
}

# Option namespaces whose values are package or module names.
const NAME_REGEX = '(?:pkgs|services|programs|virtualisation)\.([A-Za-z0-9_-]+)'

# Matches of NAME_REGEX that are not names.
const NOT_NAMES = ["callPackage"]

# Names that grep cannot see, because the only reference is a call argument, stay hand-written in ignore.txt.
def package_names [] {
  let root = (repo_root)

  let own = (
    ls ($root | path join "pkgs")
    | where type == dir
    | get name
    | each { path basename }
  )

  let referenced = (
    ["pkgs" "hosts" "home" "modules" "flake" "overlays"]
    | each { |dir|
      (
        rg --no-filename --only-matching --replace '$1' $NAME_REGEX
          --glob '!*.json' --glob '!*.lock' ($root | path join $dir)
        | complete
      ).stdout
    }
    | str join "\n"
    | lines
    | where { |name| not ($name | is-empty) }
    | where { |name| not ($name in $NOT_NAMES) }
  )

  ($own ++ $referenced) | uniq | sort
}

# Allow-list: stops names this repository defines from being flagged as misspellings.
# Host names appear in both their documentation and nix form,
# and every enforced term contributes its lowercase form too,
# so a casing mistake is reported once, as casing, rather than twice.
def write_terms [hosts: list<string>, packages: list<string>] {
  let names = (
    $hosts | each { |host| [(canonical_host_name $host) $host] } | flatten
  ) | append $packages | uniq

  let lowercase_terms = (casing_swaps (hand_listed_terms) | get wrong)

  let entries = (
    $names
    | append ($names | each { |name| $"($name)'s" })
    | append $lowercase_terms
  ) | uniq | sort

  let header = [
    "# Vale spelling allow-list generated from this repository."
    "#"
    "# Host names, repository package names, and every `pkgs.<name>` reference"
    "# in the tree. See docs/src/development/spelling_lint.md."
    "#"
    "# Generated by flake/dev/scripts/install-vale-dictionaries.nu; do not edit."
    "#"
    "# One term per line."
    ""
  ]

  let body = ($header | append $entries | str join "\n")
  $"($body)\n" | save --force (dictionary_dir | path join "terms.txt")
}

# Entries from the hand-written allow-lists, ignoring comments and blanks.
def hand_listed_terms [] {
  ["programmer.txt" "ignore.txt"]
  | each { |file| open (dictionary_dir | path join $file) | lines }
  | flatten
  | each { str trim }
  | where { |line| $line != "" and not ($line | str starts-with "#") }
}

# A name is worth enforcing only when its lowercased form is not also an allowed entry:
# listing both would make the rule reject its own allow-list.
def casing_swaps [names: list<string>] {
  $names
  | where { |name| ($name | str lowercase) != $name }
  | where { |name|
    ($names | where { |other| $other == ($name | str lowercase) } | length) == 0
  }
  | each { |name| { wrong: ($name | str lowercase), right: $name } }
}

# Casing rule: host names and hand-written terms, so that a wrongly cased
# reference is reported as such rather than as a spelling mistake.
# Lowercase names picked up by the scan are deliberately left out,
# or they would start rejecting their own capitalised forms.
def write_casing_rule [hosts: list<string>] {
  let host_swaps = (
    $hosts
    | each { |host| { wrong: $host, right: (canonical_host_name $host) } }
    | where { |swap| $swap.wrong != $swap.right }
  )

  let swaps = (
    $host_swaps ++ (casing_swaps (hand_listed_terms))
    | uniq-by wrong
    | sort-by wrong
    | each { |swap| $"  ($swap.wrong): ($swap.right)" }
  )

  let rule = [
    "# Host name and term casing, generated from this repository."
    "#"
    "# Generated by flake/dev/scripts/install-vale-dictionaries.nu; do not edit."
    "extends: substitution"
    "message: \"Use '%s' rather than '%s'.\""
    "level: error"
    "ignorecase: true"
    "swap:"
  ] | append $swaps | append ""

  ($rule | str join "\n") | save --force (styles_dir | path join "AU-English/Terms.yml")
}

def install_readonly [source: path, destination: path] {
  rm --force $destination
  cp $source $destination
  ^chmod 0444 $destination
}

# The dictionaries are handed over by the dev shell so entering it stays fast;
# anywhere else they are built on the spot.
def resolve_dictionary [name: string, reference: string] {
  let value = ($env | get -o $name | default "")
  if $value != "" and ($value | path exists) {
    return $value
  }

  log info $"($name) is unset, building ($reference)"
  (nix build --no-link --print-out-paths $reference | str trim)
}

def main [] {
  mkdir (dictionary_dir)

  let hunspell = (resolve_dictionary "HUNSPELL_EN_AU" $"nixpkgs#hunspellDicts.en_AU-large")
  install_readonly ($hunspell | path join "share/hunspell/en_AU.dic") (dictionary_dir | path join "en_AU-large.dic")
  install_readonly ($hunspell | path join "share/hunspell/en_AU.aff") (dictionary_dir | path join "en_AU-large.aff")

  let tech = (resolve_dictionary "VALE_TECH_DICTIONARY" $"(repo_root)#vale-tech-dictionary")
  install_readonly ($tech | path join "tech.dic") (dictionary_dir | path join "tech.dic")
  install_readonly ($tech | path join "tech.aff") (dictionary_dir | path join "tech.aff")

  let hosts = (list_hosts --fast --include-current)
  if ($hosts | is-empty) {
    log error "no hosts found under hosts/"
    exit 1
  }

  write_terms $hosts (package_names)
  write_casing_rule $hosts

  log info $"installed dictionaries and term lists into (styles_dir)"
}
